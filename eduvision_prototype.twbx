  <actions>
    <action caption='Filter1' name='[Action1_6CD223D475D14E889665B44641F227BF]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Student Analytics' type='sheet'>
        <exclude-sheet name='Average Faculty-to-Student Ratio Score' />
        <exclude-sheet name='Average International Student Percentage' />
        <exclude-sheet name='Average Students per Staff' />
        <exclude-sheet name='Top 10 Universities by International Student Percentage' />
      </source>
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Average International Student Percentage,Average Students per Staff,Top 10 Universities by Faculty-to-Student Ratio Score' />
        <param name='special-fields' value='all' />
        <param name='target' value='Student Analytics' />
      </command>
    </action>
    <action caption='Filter2' name='[Action2_B777187FFD5E4D9AB7C045BB8FE7C586]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='University Overview' type='sheet' worksheet='University Distribution by Country' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='University Count,Average Global Ranking Score,Average Academic Reputation Score,Average Research Impact Score,University Distribution by Country' />
        <param name='special-fields' value='all' />
        <param name='target' value='University Overview' />
      </command>
    </action>
    <action caption='Filter3' name='[Action3_B1504C96C251482391683BC80F3F8F6C]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Research Analytics' type='sheet' worksheet='Research Productivity vs Research Impact' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Research Impact Score,THE Research Score,Research Productivity vs Research Impact,Research Productivity Index,THE Citation Score' />
        <param name='special-fields' value='all' />
        <param name='target' value='Research Analytics' />
      </command>
    </action>
    <action caption='Filter4' name='[Action4_8B89E6CAF62E4D20B784488AEED17D10]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Student Analytics' type='sheet' worksheet='International Students vs Students per Staff' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Average Faculty-to-Student Ratio Score,Average International Student Percentage,Average Students per Staff,International Students vs Students per Staff' />
        <param name='special-fields' value='all' />
        <param name='target' value='Student Analytics' />
      </command>
    </action>
    <action caption='Filter5' name='[Action5_C84FD1DF05BF41E08F6C3E2351576A3B]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Country Comparison' type='sheet' worksheet='University Count by Country' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='University Count by Country' />
        <param name='special-fields' value='all' />
        <param name='target' value='Country Comparison' />
      </command>
    </action>
    <action caption='Filter6' name='[Action6_1F4BA9FEA0D3422AA9C09E67153B2774]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Country Comparison' type='sheet' worksheet='University Count by Country' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='University Count by Country' />
        <param name='special-fields' value='all' />
        <param name='target' value='Country Comparison' />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name='10 Universities with Lowest Students per Staff Ratio'>
      <table>
        <view>
          <datasources>
            <datasource caption='dim_university+' name='federated.0p00gr20qk033g1ac2voh1bh2jxc' />
          </datasources>
          <datasource-dependencies datasource='federated.0p00gr20qk033g1ac2voh1bh2jxc'>
            <column-instance column='[students_per_staff]' derivation='Avg' name='[avg:students_per_staff:qk]' pivot='key' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column-instance column='[university_name]' derivation='None' name='[none:university_name:nk]' pivot='key' type='nominal' />
            <column caption='Students Per Staff' datatype='real' name='[students_per_staff]' role='measure' type='quantitative' />
            <column caption='University Name' datatype='string' name='[university_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0p00gr20qk033g1ac2voh1bh2jxc].[Action (Country Name,University Name)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action1_6CD223D475D14E889665B44641F227BF]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[country_name]' />
              <groupfilter function='level-members' level='[university_name]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0p00gr20qk033g1ac2voh1bh2jxc].[none:university_name:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='AVG([students_per_staff])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:university_name:nk]' user:ui-manual-selection='true' user:ui-manual-selection-all-when-empty='true' user:ui-manual-selection-is-empty='true' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
