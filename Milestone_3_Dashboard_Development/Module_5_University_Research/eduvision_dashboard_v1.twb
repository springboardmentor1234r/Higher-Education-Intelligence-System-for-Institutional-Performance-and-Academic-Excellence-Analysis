  <actions>
    <action caption='Filter1' name='[Action1_6CD223D475D14E889665B44641F227BF]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Student Analytics' type='sheet'>
        <exclude-sheet name='Average Faculty-to-Student Ratio Score' />
        <exclude-sheet name='Average International Student Percentage' />
        <exclude-sheet name='Average Students per Staff' />
        <exclude-sheet name='Top 10 Universities by International Student Percentage' />
      </source>
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Average International Student Percentage,Average Students per Staff,Top 10 Universities by Faculty-to-Student Ratio Score' />
        <param name='special-fields' value='all' />
        <param name='target' value='Student Analytics' />
      </command>
    </action>
    <action caption='Filter2' name='[Action2_B777187FFD5E4D9AB7C045BB8FE7C586]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='University Overview' type='sheet' worksheet='University Distribution by Country' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='University Count,Average Global Ranking Score,Average Academic Reputation Score,Average Research Impact Score,University Distribution by Country' />
        <param name='special-fields' value='all' />
        <param name='target' value='University Overview' />
      </command>
    </action>
