        <title>
          <formatted-text>
            <run bold='true' fontcolor='#8b6cff' fontsize='11'>Research Impact Score by Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='university_final_dataset' name='federated.0eduvision1milestone34x1' />
