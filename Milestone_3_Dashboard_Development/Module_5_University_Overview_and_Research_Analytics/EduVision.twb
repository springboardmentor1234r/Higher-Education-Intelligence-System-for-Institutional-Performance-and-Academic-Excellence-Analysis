      <aliases enabled='yes' />
      <column caption='Filter Match (No Year)' datatype='boolean' name='[Calculation_1001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Parameters].[Parameter 2] = &quot;All&quot; OR [region] = [Parameters].[Parameter 2]) AND ([Parameters].[Parameter 3] = &quot;All&quot; OR [country] = [Parameters].[Parameter 3])' />
      </column>
      <column caption='Filter Match' datatype='boolean' name='[Calculation_1002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year] = [Parameters].[Parameter 1] AND [Calculation_1001]' />
      </column>
      <column caption='Has Country' datatype='boolean' name='[Calculation_1003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([country])' />
      </column>
      <column caption='KPI Universities' datatype='string' name='[Calculation_1010]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD([university_id]))' />
      </column>
      <column caption='KPI Avg Score' datatype='string' name='[Calculation_1011]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(AVG([global_ranking_score])) THEN &quot;n/a&quot; ELSE STR(ROUND(AVG([global_ranking_score]),1)) END' />
      </column>
      <column caption='KPI International Student %' datatype='string' name='[Calculation_1012]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(AVG([international_student_pct])) THEN &quot;n/a&quot; ELSE STR(ROUND(AVG([international_student_pct]),1)) + &quot;%&quot; END' />
      </column>
      <column caption='KPI Faculty Ratio' datatype='string' name='[Calculation_1013]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(AVG([faculty_student_ratio])) THEN &quot;n/a&quot; ELSE &quot;1 : &quot; + STR(ROUND(AVG([faculty_student_ratio]),1)) END' />
      </column>
      <column caption='KPI Research Productivity Index' datatype='string' name='[Calculation_1014]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(AVG([research_productivity_index])) THEN &quot;n/a&quot; ELSE STR(ROUND(AVG([research_productivity_index]),1)) END' />
      </column>
      <column caption='Rank Univ Score' datatype='integer' name='[Calculation_1020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(MAX([global_ranking_score]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank Univ Research' datatype='integer' name='[Calculation_1021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(MAX([research_productivity_index]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank Univ Impact' datatype='integer' name='[Calculation_1022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(MAX([research_impact_score]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank Univ Reputation' datatype='integer' name='[Calculation_1023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(MAX([academic_reputation_score]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank Country Intl' datatype='integer' name='[Calculation_1024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(AVG([international_student_pct]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank Country Score' datatype='integer' name='[Calculation_1025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(AVG([global_ranking_score]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank Country Count' datatype='integer' name='[Calculation_1026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(COUNTD([university_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_1489889609277440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([university_name]) * AVG([faculty_student_ratio]) * 1000' />
      </column>
      <column caption='Calculation3' datatype='real' name='[Calculation_1489889611149313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([faculty_student_ratio]) * 1000' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_1697422232817664]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;1:&quot; + STR(ROUND(AVG([faculty_student_ratio]), 1))' />
      </column>
      <column caption='top ranked university' datatype='string' name='[Calculation_1697422234320897]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Return one university name using the highest score and alphabetical tie-breaking.&#13;&#10;{ FIXED : MIN(&#13;&#10;    IF [global_ranking_score] = { FIXED : MAX([global_ranking_score]) }&#13;&#10;    THEN [university_name]&#13;&#10;    END&#13;&#10;) }' />
      </column>
      <column caption='Domestic Enrollment' datatype='real' name='[Calculation_1697422243364866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([faculty_student_ratio]) * 800' />
      </column>
