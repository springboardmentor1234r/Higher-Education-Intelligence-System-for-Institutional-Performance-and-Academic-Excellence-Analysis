    <worksheet name="Research Impact">
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment="1" fontcolor="#38bdf8" fontname="Tableau Bold" fontsize="12">Top 10: QS Citations per Faculty</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="university_dashboard_cleaned" name="federated.162hlcs07dq5n01b94jev0whq4kb" />
          </datasources>
          <datasource-dependencies datasource="federated.162hlcs07dq5n01b94jev0whq4kb">
            <column-instance column="[qs_citations_per_faculty]" derivation="Avg" name="[avg:qs_citations_per_faculty:qk]" pivot="key" type="quantitative" />
            <column caption="Country" datatype="string" name="[country]" role="dimension" semantic-role="[Country].[ISO3166_2]" type="nominal" />
            <column-instance column="[university]" derivation="None" name="[none:university:nk]" pivot="key" type="nominal" />
            <column caption="QS Citations per Faculty" datatype="real" name="[qs_citations_per_faculty]" role="measure" type="quantitative" />
            <column caption="University" datatype="string" name="[university]" role="dimension" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.162hlcs07dq5n01b94jev0whq4kb].[Action (Country)]" context="true">
            <groupfilter function="level-members" level="[country]" />
          </filter>
          <filter class="categorical" column="[federated.162hlcs07dq5n01b94jev0whq4kb].[Action (University)]" context="true">
            <groupfilter function="member" level="[university]" member="&quot;Amirkabir University of Technology&quot;" ns0:ui-action-filter="[Action_Research_Filter_Univ]" ns0:ui-domain="database" ns0:ui-enumeration="inclusive" ns0:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[federated.162hlcs07dq5n01b94jev0whq4kb].[none:university:nk]">
            <groupfilter count="10" end="top" function="end" units="records" ns0:ui-marker="end">
              <groupfilter direction="DESC" expression="AVG([qs_citations_per_faculty])" function="order" ns0:ui-marker="order">
                <groupfilter function="level-members" level="[none:university:nk]" ns0:ui-enumeration="all" ns0:ui-marker="enumerate" />
              </groupfilter>
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort="[federated.162hlcs07dq5n01b94jev0whq4kb].[none:university:nk]" direction="DESC" is-on-innermost-dimension="true" measure-to-sort-by="[federated.162hlcs07dq5n01b94jev0whq4kb].[avg:qs_citations_per_faculty:qk]" shelf="rows" />
          </shelf-sorts>
          <slices>
            <column>[federated.162hlcs07dq5n01b94jev0whq4kb].[Action (Country)]</column>
            <column>[federated.162hlcs07dq5n01b94jev0whq4kb].[Action (University)]</column>
            <column>[federated.162hlcs07dq5n01b94jev0whq4kb].[none:university:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
